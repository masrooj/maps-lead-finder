# Create an API key in Google Cloud, enable Places API (New), and enable billing.
GOOGLE_MAPS_API_KEY=replace_with_your_google_places_api_key
POSTGRES_PASSWORD=change-this-password
APP_PORT=8000
DB_PORT=5433
# Optional: website social-link discovery is best-effort and only checks public homepage links.
DISCOVER_SOCIAL_LINKS=true
