# Create an API key in Google Cloud, enable Places API (New), and enable billing.
GOOGLE_MAPS_API_KEY=replace_with_your_google_places_api_key
POSTGRES_PASSWORD=change-this-password
APP_PORT=8000
DB_PORT=5433
# Optional: website social-link discovery is best-effort and only checks public homepage links.
DISCOVER_SOCIAL_LINKS=true
# Single-account login (username is always hello@appointhive.com). Login fails closed if either is unset.
LOGIN_PASSWORD=replace_with_a_strong_login_password
SESSION_SECRET=replace_with_a_long_random_secret
