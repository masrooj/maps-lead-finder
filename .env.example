# Create an API key in Google Cloud, enable Places API (New), and enable billing.
GOOGLE_MAPS_API_KEY=replace_with_your_google_places_api_key
POSTGRES_PASSWORD=change-this-password
APP_PORT=8000
DB_PORT=5433
# Vercel / Neon: set DATABASE_URL to your Postgres connection string
# DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
# Optional: website social-link discovery is best-effort and only checks public homepage links.
DISCOVER_SOCIAL_LINKS=true
# Owner bootstrap login (hello@appointhive.com). Team users sign in with their own email + password.
LOGIN_PASSWORD=replace_with_a_strong_login_password
SESSION_SECRET=replace_with_a_long_random_secret

# Sales OS (optional — defaults apply if unset)
# DEFAULT_CURRENCY=AUD
# DEFAULT_TIMEZONE=Australia/Sydney
# WON_ON=first_payment
# SAAS_ENABLED=false
# CRON_SECRET=replace_with_cron_shared_secret

# Public URL used for Stripe/PayPal success & cancel redirects (no trailing slash)
# PUBLIC_BASE_URL=http://localhost:8000

# AppointHive Booking Engine bridge (optional — prefer Owner UI: Workspace → AppointHive)
# APPOINTHIVE_BASE_URL=http://127.0.0.1:3010
# APPOINTHIVE_CRM_SHARED_SECRET=
# APPOINTHIVE_BRIDGE_ENABLED=true

# Payment providers (optional; leave unset until ready — never commit real secrets)
# With STRIPE_SECRET_KEY set, invoice creation calls Stripe Checkout Sessions API.
# With PAYPAL_CLIENT_ID + PAYPAL_CLIENT_SECRET, invoice creation creates a PayPal order.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MODE=test
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_MODE=sandbox
# PAYONEER_PAYEE_EMAIL=
# PAYONEER_API_KEY=
# PAYONEER_WEBHOOK_SECRET=
# SKRILL_PAY_TO_EMAIL=
# SKRILL_MERCHANT_ID=
# SKRILL_SECRET=
# SKRILL_WEBHOOK_SECRET=

# SMTP (invoice Send email + PDF). Also configurable in Money → Mail / SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=sales@example.com
# SMTP_TLS=true

# Demo uploads: local (Docker volume) or S3/R2 for Vercel / durable storage
# STORAGE_BACKEND=local
# UPLOADS_DIR=uploads
# UPLOADS_PUBLIC_BASE=http://localhost:8000
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_PUBLIC_BASE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# Optional: SETTINGS_ENCRYPTION_KEY=  (else SESSION_SECRET derives encryption key)
